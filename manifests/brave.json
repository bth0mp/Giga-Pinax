{
  "manifest_version": 3,
  "name": "Giga Pinax",
  "version": "0.19.0",
  "description": "Look up ancient coin types by RIC, RRC, SC, Bopearachchi or Price reference and see recent acsearch hammer prices.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Open Giga Pinax"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["contextMenus"],
  "host_permissions": [
    "https://numismatics.org/*",
    "https://nomisma.org/*",
    "https://www.acsearch.info/*"
  ]
}
