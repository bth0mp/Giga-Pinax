{
  "manifest_version": 3,
  "name": "Giga Pinax",
  "version": "0.34.0",
  "description": "Research ancient coins and sale prices; manage local auction, provenance and collection records.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "sidebar_action": { "default_panel": "popup.html?panel=1", "default_title": "Giga Pinax research" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Open Giga Pinax"
    }
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "alarms"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["https://www.coinarchives.com/*"],
  "host_permissions": [
    "https://numismatics.org/*",
    "https://nomisma.org/*",
    "https://www.acsearch.info/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "giga-pinax@local.invalid",
      "update_url": "https://bth0mp.github.io/Giga-Pinax/firefox/updates.json",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms",
          "websiteContent"
        ]
      }
    }
  }
}
