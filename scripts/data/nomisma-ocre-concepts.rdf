        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Pescennius Niger</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">Pescennius Niger</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">Pescenniusz Niger</skos:prefLabel>
