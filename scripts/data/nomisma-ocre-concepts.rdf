      <skos:prefLabel xml:lang="uk">Фелікітас</skos:prefLabel>
      <skos:prefLabel xml:lang="ru">Фелицитас</skos:prefLabel>
      <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1403069"/>
      <skos:exactMatch rdf:resource="https://www.freebase.com/m/0lnv4"/>
