        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Julia Paula</skos:prefLabel>
        <skos:definition xml:lang="en">Julia Cornelia Paula or Julia Paula was a distinguished Roman noblewoman who became Empress of Rome as the first wife of the Roman emperor Elagabalus.</skos:definition>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/roman_numismatics"/>
