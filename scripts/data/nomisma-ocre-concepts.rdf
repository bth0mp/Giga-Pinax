        <skos:prefLabel xml:lang="pt">Pompeu</skos:prefLabel>
        <skos:definition xml:lang="en">Gnaeus Pompeius Magnus (29 September 106 BC – 28 September 48 BC), usually known in English as Pompey or Pompey the Great, was a military and political leader of the late Roman Republic.</skos:definition>
        <skos:exactMatch rdf:resource="http://dbpedia.org/resource/Pompey"/>
        <skos:exactMatch rdf:resource="http://viaf.org/viaf/6224297/"/>
