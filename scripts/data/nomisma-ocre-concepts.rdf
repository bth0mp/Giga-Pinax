        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Julian the Apostate</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">Julian Apostata</skos:prefLabel>
        <skos:prefLabel xml:lang="ja">フラウィウス・クラウディウス・ユリアヌス</skos:prefLabel>
