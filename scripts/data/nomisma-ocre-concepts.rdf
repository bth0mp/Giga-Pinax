        <skos:prefLabel xml:lang="en">Honos</skos:prefLabel>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="en">Honos was the Roman god personifying honor. He was closely associated with Virtus, the goddess of manliness, or bravery, and the two are frequently depicted together.</skos:definition>
