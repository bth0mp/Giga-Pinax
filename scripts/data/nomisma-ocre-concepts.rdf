        <skos:prefLabel xml:lang="ru">Вибия Сабина</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">Vibia Sabina</skos:prefLabel>
        <skos:prefLabel xml:lang="es">Vibia Sabina</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">Vibia Sabina</skos:prefLabel>
        <skos:definition xml:lang="en">Vibia Sabina (83–136/137) was a Roman Empress, wife and second cousin, once removed, to Roman Emperor Hadrian. She was the daughter to Salonina Matidia (niece of Roman Emperor Trajan), and Lucius Vibius Sabinus. In 128, she was awarded the title of Augusta. She died before Hadrian, some time in 136 or early 137, and was deified.</skos:definition>
        <skos:exactMatch rdf:resource="http://viaf.org/viaf/43147132/"/>
        <skos:exactMatch rdf:resource="http://dbpedia.org/resource/Vibia_Sabina"/>
