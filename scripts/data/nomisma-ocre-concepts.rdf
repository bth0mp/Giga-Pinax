        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Faustina the Younger</skos:prefLabel>
        <skos:prefLabel xml:lang="ja">アンニア・ガレリア・ファウスティナ・ミノル</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">Faustina de Jongere</skos:prefLabel>
        <skos:prefLabel xml:lang="es">Faustina la Menor</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">小福斯蒂娜</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Faustina d.y.</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">Faustyna Młodsza</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Faustina minore</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Faustina die Jüngere</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Faustine la Jeune</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">Фаустина Младшая</skos:prefLabel>
        <skos:definition xml:lang="en">Annia Galeria Faustina Minor, Faustina Minor or Faustina the Younger (16 February between 125 and 130 – 175) was a daughter of Antoninus Pius and Faustina the Elder. She was Empress and wife to her cousin Marcus Aurelius.</skos:definition>
        <skos:exactMatch rdf:resource="http://viaf.org/viaf/96312073/"/>
        <skos:exactMatch rdf:resource="http://dbpedia.org/resource/Faustina_the_Younger"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/roman_numismatics"/>
        <skos:altLabel xml:lang="la">Annia Galeria Faustina Minor</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q236936"/>
        <skos:prefLabel xml:lang="bs">Faustina Mlađa</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">Genç Faustina</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Faustina nuorempi</skos:prefLabel>
        <skos:prefLabel xml:lang="uk">Фаустіна Молодша</skos:prefLabel>
        <skos:prefLabel xml:lang="br">Faustina ar Yaouankañ</skos:prefLabel>
        <skos:prefLabel xml:lang="bg">Фаустина Млада</skos:prefLabel>
        <skos:prefLabel xml:lang="sh">Faustina Mlađa</skos:prefLabel>
