        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2186"/>
        <skos:exactMatch rdf:resource="http://dbpedia.org/resource/Romulus"/>
        <skos:prefLabel xml:lang="it">Romolo</skos:prefLabel>
