        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Pompey</skos:prefLabel>
        <skos:prefLabel xml:lang="es">Cneo Pompeyo Magno</skos:prefLabel>
        <skos:prefLabel xml:lang="pl">Pompejusz</skos:prefLabel>
