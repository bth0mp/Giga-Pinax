        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Tacitus</skos:prefLabel>
        <skos:definition xml:lang="en">Marcus Claudius Tacitus was Roman emperor from 275 to 276. During his short reign he campaigned against the Goths and the Heruli, for which he received the title Gothicus Maximus.</skos:definition>
        <skos:prefLabel xml:lang="de">Tacitus</skos:prefLabel>
