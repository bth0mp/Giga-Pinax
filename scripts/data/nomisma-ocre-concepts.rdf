        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/roman_provincial_numismatics"/>
      
        <skos:definition xml:lang="en">Titus (Latin: Titus Flāvius Caesar Vespasiānus Augustus; 30 December 39 AD – 13 September 81 AD) was Roman emperor from 79 to 81. A member of the Flavian dynasty, Titus succeeded his father Vespasian upon his death, thus becoming the first Roman Emperor to come to the throne after his own biological father.</skos:definition>
        <skos:prefLabel xml:lang="da">Titus</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">Titus</skos:prefLabel>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
