        <skos:scopeNote xml:lang="en">This concept should only be used as a portrait, not authority.</skos:scopeNote>
        <skos:prefLabel xml:lang="en">Romulus</skos:prefLabel>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:definition xml:lang="en">Romulus is the legendary founder of Rome and its first king, ruling (according to tradition) from 753 - 716 B.C. Romulus appears on coinage from the Roman Republic to the modern period.</skos:definition>
        <skos:inScheme rdf:resource="http://nomisma.org/id/"/>
        <skos:changeNote rdf:resource="http://nomisma.org/id/romulus#provenance"/>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/roman_numismatics"/>
