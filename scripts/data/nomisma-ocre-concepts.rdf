        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Sabina</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Vibia Sabina</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Sabine (épouse d'Hadrien)</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Vibia Sabina</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Vibia Sabina</skos:prefLabel>
