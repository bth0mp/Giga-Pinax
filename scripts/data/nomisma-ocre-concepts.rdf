        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Macrianus Minor</skos:prefLabel>
        <skos:definition xml:lang="en">Titus Fulvius Iunius Macrianus (died 261), also known as Macrianus Minor, was a Roman usurper. He was the son of Fulvius Macrianus, also known as Macrianus Major. He reigned with his brother, Quietus.</skos:definition>
        <bio:death rdf:resource="http://nomisma.org/id/macrianus_minor#death"/>
        <skos:altLabel xml:lang="de">Macrianus der Jüngere</skos:altLabel>
