        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Severus II</skos:prefLabel>
        <skos:definition xml:lang="en">Flavius Valerius Severus, also Severus II, was a Roman emperor from 306 to 307. After failing to besiege Rome, he fled to Ravenna. It is thought that he was killed there or executed near Rome.</skos:definition>
