        <skos:prefLabel xml:lang="en">Flavia Iulia Constantia</skos:prefLabel>
        <skos:definition xml:lang="en">Flavia Iulia Constantia, sister of the Roman Emperor Constantine the Great and wife of Licinius I.</skos:definition>
