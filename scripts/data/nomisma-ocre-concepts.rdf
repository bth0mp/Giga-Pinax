        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Matidia</skos:prefLabel>
        <skos:prefLabel xml:lang="es">Matidia</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Matidia</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Salonina Matidia</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Salonina Matidia</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">Matidia</skos:prefLabel>
        <skos:definition xml:lang="en">Salonina Matidia (4 July 68 – 23 December 119) was the daughter of Ulpia Marciana and Gaius Salonius Matidius Patruinus. She was the niece of the Emperor Trajan. Her daughter Vibia Sabina married the Emperor Hadrian. Matidia died in AD 119 and was deified by Hadrian.</skos:definition>
