        <skos:prefLabel xml:lang="es">Tácito (emperador)</skos:prefLabel>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/roman_numismatics"/>
      
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q177988"/>
