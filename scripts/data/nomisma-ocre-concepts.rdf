        <skos:prefLabel xml:lang="sv">Manlia Scantilla</skos:prefLabel>
        <skos:definition xml:lang="en">Manlia Scantilla (fl. 193) was Roman Empress as wife to the Roman Emperor Didius Julianus. She was the mother of Didia Clara.</skos:definition>
        <skos:exactMatch rdf:resource="http://dbpedia.org/resource/Manlia_Scantilla"/>
