        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Domitius Domitianus</skos:prefLabel>
        <skos:definition xml:lang="en">Lucius Domitius Domitianus was a Roman usurper against Diocletian, who seized power for a short time in Aegyptus.</skos:definition>
