    </org:Membership><foaf:Person xmlns:wordnet="http://ontologi.es/WordNet/class/"
                 xmlns:crmdig="http://www.ics.forth.gr/isl/CRMdig/"
                 xmlns:bio="http://purl.org/vocab/bio/0.1/"
                 rdf:about="http://nomisma.org/id/carinus">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Carinus</skos:prefLabel>
        <skos:definition xml:lang="en">Carinus (Marcus Aurelius Carinus) was Roman emperor from 283 to 285. The elder son of emperor Carus, he was first appointed Caesar and in the beginning of 283 co-emperor of the western portion of the empire by his father.</skos:definition>
