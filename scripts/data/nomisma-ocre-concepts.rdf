        <skos:prefLabel xml:lang="zh">克劳狄·塔西佗</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">Tacitus (keizer)</skos:prefLabel>
        <skos:prefLabel xml:lang="ja">マルクス・クラウディウス・タキトゥス</skos:prefLabel>
