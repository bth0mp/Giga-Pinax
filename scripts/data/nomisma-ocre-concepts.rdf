        <skos:exactMatch rdf:resource="http://viaf.org/viaf/40174483/"/>
        <skos:altLabel xml:lang="la">Gaius Pescennius Niger</skos:altLabel>
        <dcterms:isPartOf rdf:resource="http://nomisma.org/id/roman_numismatics"/>
      
