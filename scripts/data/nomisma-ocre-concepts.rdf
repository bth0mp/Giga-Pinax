        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Maxentius</skos:prefLabel>
        <skos:definition xml:lang="en">Maxentius (Marcus Aurelius Valerius Maxentius; c. 276 – 28 October 312) was Roman emperor from 306 to 312. He was the son of former Emperor Maximian and the son-in-law of Emperor Galerius.</skos:definition>
