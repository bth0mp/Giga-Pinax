  <rdf:Description rdf:about="http://numismatics.org/ocre/id/ric.1.test.1#obverse">
    <nmo:hasLegend>OBV ONE</nmo:hasLegend>
    <dcterms:description xml:lang="fr">Portrait français</dcterms:description>
    <dcterms:description xml:lang="en">English obverse</dcterms:description>
    <nmo:hasPortrait rdf:resource="http://nomisma.org/id/person_one"/>
    <nmo:hasPortrait rdf:resource="http://nomisma.org/id/person_two"/>
  </rdf:Description>

  <nmo:TypeSeriesItem rdf:about="http://numismatics.org/ocre/id/ric.1.test.1">
    <skos:prefLabel xml:lang="fr">Titre français</skos:prefLabel>
    <skos:prefLabel xml:lang="en">RIC I Test 1</skos:prefLabel>
    <nmo:hasAuthority rdf:resource="http://nomisma.org/id/authority_one"/>
    <nmo:hasAuthority rdf:resource="http://nomisma.org/id/authority_two"/>
    <nmo:hasIssuer rdf:resource="http://nomisma.org/id/ignored_issuer"/>
    <nmo:hasDenomination rdf:resource="http://nomisma.org/id/denarius"/>
    <nmo:hasDenomination rdf:resource="http://nomisma.org/id/aureus"/>
    <nmo:hasMint rdf:resource="http://nomisma.org/id/rome"/>
    <nmo:hasMaterial rdf:resource="http://nomisma.org/id/ar"/>
    <nmo:hasStartDate>-0009</nmo:hasStartDate>
    <nmo:hasEndDate>0014</nmo:hasEndDate>
    <nmo:hasObverse rdf:resource="http://numismatics.org/ocre/id/ric.1.test.1#obverse"/>
    <nmo:hasReverse rdf:resource="http://numismatics.org/ocre/id/ric.1.test.1#reverse"/>
  </nmo:TypeSeriesItem>

  <rdf:Description rdf:about="http://numismatics.org/ocre/id/ric.1.test.1#reverse">
    <nmo:hasLegend>REV ONE</nmo:hasLegend>
    <dcterms:description xml:lang="en">English reverse</dcterms:description>
    <nmo:hasPortrait rdf:resource="http://example.test/not-a-nomisma-slug"/>
  </rdf:Description>

  <nmo:TypeSeriesItem rdf:about="http://numismatics.org/ocre/id/ric.2.test.2">
    <skos:prefLabel xml:lang="en">RIC II Test 2</skos:prefLabel>
