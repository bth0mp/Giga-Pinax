    <nmo:hasIssuer rdf:resource="http://nomisma.org/id/issuer_only"/>
  </nmo:TypeSeriesItem>

  <nmo:TypeSeriesItem rdf:about="http://numismatics.org/ocre/id/ric.3.old.1">
    <skos:prefLabel xml:lang="en">Old one</skos:prefLabel>
    <dcterms:isReplacedBy rdf:resource="http://numismatics.org/ocre/id/ric.3.old.2"/>
  </nmo:TypeSeriesItem>
  <nmo:TypeSeriesItem rdf:about="http://numismatics.org/ocre/id/ric.3.old.2">
