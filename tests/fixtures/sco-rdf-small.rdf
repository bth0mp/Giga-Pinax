  </nmo:TypeSeriesItem>
  <rdf:Description rdf:about="http://numismatics.org/sco/id/sc.1.1266.2#obverse">
    <dcterms:description xml:lang="en">Diademed head of Demetrius II right, bearded, with touseled locks on crown of head and stubby horns at temple</dcterms:description>
    <nmo:hasPortrait rdf:resource="http://nomisma.org/id/demetrius_ii_nicator"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://numismatics.org/sco/id/sc.1.1266.2#reverse">
    <nmo:hasLegend xml:lang="grc">BAΣΙΛΕΩΣ ΔHMHTPIOY ΘEOY NIKATOPOΣ</nmo:hasLegend>
    <dcterms:description xml:lang="en">Zeus seated on high-backed throne left, resting on scepter and extending right hand through legend, holding Nike who faces left, extending wreath toward edge of coin</dcterms:description>
    <nmo:hasPortrait rdf:resource="http://nomisma.org/id/zeus"/>
  </rdf:Description>

