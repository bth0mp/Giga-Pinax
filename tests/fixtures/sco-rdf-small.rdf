  <rdf:Description rdf:about="http://numismatics.org/sco/id/sc.1.1266#obverse">
    <dcterms:description xml:lang="en">Diademed head of Antiochus III right (Type B)</dcterms:description>
    <dcterms:description xml:lang="fr">Tête diadémée d'Antiochos III à droite (type B)</dcterms:description>
    <nmo:hasPortrait rdf:resource="http://nomisma.org/id/antiochus_iii"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://numismatics.org/sco/id/sc.1.1266#reverse">
    <nmo:hasLegend xml:lang="grc">BAΣΙΛΕΩΣ ANTIOXOY</nmo:hasLegend>
    <dcterms:description xml:lang="en">Horse grazing left</dcterms:description>
    <dcterms:description xml:lang="fr">Cheval paissant à gauche</dcterms:description>
  </rdf:Description>

  <nmo:TypeSeriesItem rdf:about="http://numismatics.org/sco/id/sc.1.1266.2">
    <skos:prefLabel xml:lang="en">Seleucid Coins (part 1) 1266.2</skos:prefLabel>
    <dcterms:source rdf:resource="http://nomisma.org/id/seleucid_coins"/>
    <skos:broader rdf:resource="http://numismatics.org/sco/id/sc.1.1266"/>
