    <nmo:hasDenomination rdf:resource="http://nomisma.org/id/tetradrachm"/>
    <nmo:hasMaterial rdf:resource="http://nomisma.org/id/ar"/>
    <nmo:hasAuthority rdf:resource="http://nomisma.org/id/alexander_iii"/>
    <nmo:hasStatedAuthority rdf:resource="http://nomisma.org/id/alexander_iii"/>
    <nmo:hasMint>
      <rdf:Description>
