  </nmo:TypeSeriesItem>
  <rdf:Description rdf:about="http://numismatics.org/pella/id/price.23#obverse">
    <dcterms:description xml:lang="en">Head of beardless Heracles right wearing lion skin headdress</dcterms:description>
    <dcterms:description xml:lang="de">Kopf des jugendlichen Herakles nach r. mit Löwenfellexuvie</dcterms:description>
    <dcterms:description xml:lang="fr">Tête d'Héraclès imberbe à dr. coiffé d'une dépouille de lion</dcterms:description>
    <nmo:hasPortrait rdf:resource="http://nomisma.org/id/heracles"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://numismatics.org/pella/id/price.23#reverse">
    <nmo:hasLegend xml:lang="grc">ΑΛΕΞΑΝΔΡΟΥ</nmo:hasLegend>
    <dcterms:description xml:lang="en">Zeus seated on stool-throne left, eagle on outstretched right hand, sceptre in left hand</dcterms:description>
    <dcterms:description xml:lang="de">Zeus nach l. thronend, in der ausgestreckten R. Adler und in der L. Zepter haltend</dcterms:description>
    <dcterms:description xml:lang="fr">Zeus assis à g. sur un trône, un aigle dans la main dr. tendue et un sceptre dans la main g.</dcterms:description>
    <nmo:hasPortrait rdf:resource="http://nomisma.org/id/zeus"/>
  </rdf:Description>

