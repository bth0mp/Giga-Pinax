    <rdf:Description xmlns:la="https://linked.art/ns/terms/"
                     rdf:about="http://numismatics.org/pco/id/cpe.1_1.466A#obverse">
        <dcterms:description xml:lang="en">Diademed Head of Ptolemy I right, aegis tied around neck, sometimes tiny Δ or H behind ear, dotted border</dcterms:description>
        <nmo:hasPortrait rdf:resource="http://nomisma.org/id/ptolemy_i"/>
    </rdf:Description>
    <rdf:Description xmlns:la="https://linked.art/ns/terms/"
                     rdf:about="http://numismatics.org/pco/id/cpe.1_1.466A#reverse">
        <nmo:hasLegend>ΠΤΟΛΕΜΑΙΟΥ l. ΒΑΣΙΛΕΩΣ r.</nmo:hasLegend>
        <dcterms:description xml:lang="en">Eagle with closed wings standing left on thunderbolt, dotted border</dcterms:description>
        <nmo:hasControlmark rdf:resource="http://numismatics.org/pco/symbol/monogram.lorber.62"/>
        <nmo:hasControlmark rdf:resource="http://numismatics.org/pco/symbol/monogram.lorber.120"/>
    </rdf:Description>
