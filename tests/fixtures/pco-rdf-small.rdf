    <nmo:TypeSeriesItem xmlns:la="https://linked.art/ns/terms/"
                        rdf:about="http://numismatics.org/pco/id/cpe.1_1.330">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Coins of the Ptolemaic Empire Vol. I, Part 1, no. 330</skos:prefLabel>
        <skos:definition xml:lang="en">Coins of the Ptolemaic Empire Vol. I, Part 1, no. 330</skos:definition>
        <dcterms:source rdf:resource="http://nomisma.org/id/coins_ptolemaic_empire"/>
        <nmo:hasDenomination rdf:resource="http://nomisma.org/id/decadrachm"/>
        <nmo:hasMaterial rdf:resource="http://nomisma.org/id/ar"/>
        <nmo:hasAuthority rdf:resource="http://nomisma.org/id/ptolemy_ii"/>
        <nmo:hasMint rdf:resource="http://nomisma.org/id/alexandreia_egypt"/>
        <nmo:hasStartDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">-0270</nmo:hasStartDate>
        <nmo:hasEndDate rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">-0246</nmo:hasEndDate>
        <nmo:hasObverse rdf:resource="http://numismatics.org/pco/id/cpe.1_1.330#obverse"/>
        <nmo:hasReverse rdf:resource="http://numismatics.org/pco/id/cpe.1_1.330#reverse"/>
